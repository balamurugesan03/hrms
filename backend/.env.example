PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/hrms
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_REFRESH_EXPIRE=30d
FRONTEND_URL=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@hrms.com
FROM_NAME=HRMS System
UPLOAD_PATH=uploads
MAX_FILE_SIZE=5242880

# Shown on payslip PDFs
COMPANY_NAME=HRMS
# Check-in times and "today" use the server timezone
TZ=Asia/Kolkata

# Leave & payroll rules
# Monthly permission allowance in minutes (beyond it a request counts as half-day LOP)
PERMISSION_MONTHLY_MINUTES=120
# Longest single permission in minutes (longer -> apply leave)
PERMISSION_MAX_MINUTES=240
# Permission requests are accepted only before this time of day (HH:mm)
PERMISSION_SAME_DAY_CUTOFF=09:15
# Weekly off days for payroll (0=Sun ... 6=Sat)
WEEKLY_OFF_DAYS=0,6
