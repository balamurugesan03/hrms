PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hrms?retryWrites=true&w=majority
JWT_SECRET=<run: openssl rand -hex 48>
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=<run: openssl rand -hex 48>
JWT_REFRESH_EXPIRE=30d
FRONTEND_URL=https://unizova.com/hrms
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
FROM_EMAIL=noreply@unizova.com
FROM_NAME=Unizova HRMS
UPLOAD_PATH=uploads
MAX_FILE_SIZE=5242880

# Shown on payslip PDFs
COMPANY_NAME=HRMS
# Check-in times and "today" use the server timezone
TZ=Asia/Kolkata

# Leave & payroll rules
# Monthly permission allowance in minutes (beyond it a request counts as half-day LOP)
PERMISSION_MONTHLY_MINUTES=120
# Longest single permission in minutes (longer -> apply leave)
PERMISSION_MAX_MINUTES=240
# Permission requests are accepted only before this time of day (HH:mm)
PERMISSION_SAME_DAY_CUTOFF=09:15
# Weekly off days for payroll (0=Sun ... 6=Sat)
WEEKLY_OFF_DAYS=0,6
PAYROLL_CYCLE_START_DAY=26
ESI_NEW_RULE_FROM=2026-09-17
