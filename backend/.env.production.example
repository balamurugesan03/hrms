PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hrms?retryWrites=true&w=majority
JWT_SECRET=<run: openssl rand -hex 48>
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=<run: openssl rand -hex 48>
JWT_REFRESH_EXPIRE=30d
FRONTEND_URL=https://unizova.com/hrms
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
FROM_EMAIL=noreply@unizova.com
FROM_NAME=Unizova HRMS
UPLOAD_PATH=uploads
MAX_FILE_SIZE=5242880
